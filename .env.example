# =====================================================
# NGATURI CMS — contoh environment. Salin ke .env.local
# =====================================================

# ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INVITATION_DOMAINS=ngaturi.com,localhost:3000

# ---------- Database (PostgreSQL 16) ----------
DATABASE_URL=postgresql://user:pass@localhost:5432/ngaturi
DATABASE_POOL_SIZE=10

# ---------- Redis 7 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Object Storage (S3-compatible / Tigris) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
S3_BUCKET=ngaturi-uploads
S3_PUBLIC_URL=https://your-bucket.t3.tigrisfiles.io
MAX_UPLOAD_MB=10

# ---------- Auth: Better Auth (Google OAuth ONLY) ----------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI di Google Console:
#   http://localhost:3000/api/auth/callback/google

# ---------- Anti-spam: Cloudflare Turnstile (opsional saat dev) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Cron (Vercel Cron memanggil /api/cron/* dengan header ini) ----------
CRON_SECRET=generate-a-random-hex-string

# ---------- Payment: Midtrans (opsional, Phase 1.7) ----------
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------- Email: Resend (opsional) ----------
RESEND_API_KEY=
EMAIL_FROM="Ngaturi <noreply@ngaturi.com>"

# ---------- Monitoring (opsional) ----------
SENTRY_DSN=

# Admin bootstrap — email dipromosikan jadi admin oleh `npm run db:seed`
ADMIN_EMAILS=
