# =====================================================
# NGATURI CMS — contoh environment. Salin ke .env.local
# =====================================================

# ---------- App ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INVITATION_DOMAINS=ngaturi.com,localhost:3000

# ---------- Database (PostgreSQL 16) ----------
DATABASE_URL=postgresql://user:pass@localhost:5432/ngaturi
# Node development/scripts only. Workers always use max 5 via Hyperdrive.
DATABASE_POOL_SIZE=10

# ---------- Redis REST (Worker-compatible external Redis) ----------
REDIS_REST_URL=https://your-redis-rest-endpoint
REDIS_REST_TOKEN=

# ---------- Object Storage (S3-compatible / Tigris) ----------
# Workers use the MEDIA_BUCKET R2 binding for server-side reads/writes. These
# credentials remain necessary for direct-upload presigning and Node fallback.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
S3_BUCKET=ngaturi-uploads
S3_PUBLIC_URL=https://your-bucket.t3.tigrisfiles.io
MAX_UPLOAD_MB=10

# ---------- Auth: Better Auth (Google OAuth ONLY) ----------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI di Google Console:
#   http://localhost:3000/api/auth/callback/google

# ---------- Anti-spam: Cloudflare Turnstile (opsional saat dev) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Cron (autentikasi untuk endpoint /api/cron/*) ----------
# Development cloud-lab: Linux cron membaca nilai ini dari .env.local lalu
# memanggil aplikasi di localhost. Jangan tulis secret literal di crontab.
CRON_SECRET=generate-a-random-hex-string

# ---------- Payment: DOKU ----------
# dari dashboard.doku.com -> Integration -> Client ID & Secret Key
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# sandbox: https://api-sandbox.doku.com  | produksi: https://api.doku.com
DOKU_BASE_URL=https://api-sandbox.doku.com
# Tujuan redirect browser setelah checkout selesai. Notification URL tidak
# dikirim oleh aplikasi; atur /payment/webhook/doku per channel di DOKU Back Office.
DOKU_CALLBACK_URL=https://ngaturi.com/payment/callback

# ---------- Musik: Jamendo (opsional, untuk pencarian lagu di builder) ----------
# daftar gratis di https://developer.jamendo.com -> buat app -> Client ID
JAMENDO_CLIENT_ID=

# ---------- Email: Resend (opsional) ----------
RESEND_API_KEY=
EMAIL_FROM="Ngaturi <noreply@ngaturi.com>"

# ---------- Monitoring (opsional) ----------
SENTRY_DSN=

# Admin bootstrap — email dipromosikan jadi admin oleh `npm run db:seed`
ADMIN_EMAILS=
