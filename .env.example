# =====================================================
# NGATURI CMS — contoh environment. Salin ke .env.local
# =====================================================

# ---------- App ----------
NODE_ENV=development
# Optional legacy value. Browser auth uses its current origin; server URLs use BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3030
NEXT_PUBLIC_INVITATION_DOMAINS=ngaturi.com,localhost:3030

# ---------- Database (Neon, direct PostgreSQL) ----------
DATABASE_URL=postgresql://user:password@your-direct-endpoint.neon.tech/ngaturi?sslmode=verify-full
# Node enforces certificate/hostname verification even for sslmode=require.
# Use the direct/unpooled endpoint for this phase and controlled migrations.
# Workers do not receive this variable; they always use max 5 via HYPERDRIVE.
DATABASE_POOL_SIZE=5

# ---------- Redis ----------
REDIS_TRANSPORT=rest
REDIS_REST_URL=https://your-database.upstash.io
REDIS_REST_TOKEN=replace-with-dev-rest-token
# Explicit legacy Node fallback only: set REDIS_TRANSPORT=tcp, remove both
# REST variables, and supply REDIS_URL. Workers always use REST.
# REDIS_URL=redis://localhost:6379/0

# ---------- Object Storage (R2 S3-compatible HTTPS) ----------
# Workers use the MEDIA_BUCKET R2 binding for server-side reads/writes. These
# credentials remain necessary for presigning and the Node audio/storage path.
# Node image processing is intentionally unavailable during the migration.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://your-account-id.r2.cloudflarestorage.com
AWS_REGION=auto
S3_BUCKET=your-dev-r2-bucket
S3_PUBLIC_URL=https://media.example.com
# Worker binding writes use this custom-domain origin. Do not use r2.dev.
R2_PUBLIC_URL=https://media.example.com
# Comma-separated old media URL prefixes, including any existing bucket path.
# Stored URLs are not rewritten. Preserve legacy storage while still referenced.
LEGACY_MEDIA_PUBLIC_URLS=https://legacy-media.example.com/bucket
MAX_UPLOAD_MB=10
# Set true for Node only after the origin accepts requests solely from trusted
# Cloudflare ingress. Worker invocations trust their own Cloudflare context.
TRUST_CLOUDFLARE_INGRESS=false

# ---------- Auth: Better Auth (Google OAuth ONLY) ----------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3030
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI di Google Console:
#   http://localhost:3030/api/auth/callback/google
# Staging/production must set BETTER_AUTH_URL to the canonical HTTPS
# application origin. Do not use request headers as the OAuth origin and do
# not share provider credentials or auth secrets.

# ---------- Anti-spam: Cloudflare Turnstile (opsional saat dev) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Cron (autentikasi untuk endpoint /api/cron/*) ----------
# Development cloud-lab: Linux cron membaca nilai ini dari .env.local lalu
# memanggil aplikasi di localhost. Jangan tulis secret literal di crontab.
CRON_SECRET=generate-a-random-hex-string

# ---------- Payment: DOKU ----------
# dari dashboard.doku.com -> Integration -> Client ID & Secret Key
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# sandbox: https://api-sandbox.doku.com  | produksi: https://api.doku.com
DOKU_BASE_URL=https://api-sandbox.doku.com
# Tujuan redirect browser setelah checkout selesai. Notification URL tidak
# dikirim oleh aplikasi; atur /payment/webhook/doku per channel di DOKU Back Office.
DOKU_CALLBACK_URL=http://localhost:3030/payment/callback

# ---------- Musik: Jamendo (opsional, untuk pencarian lagu di builder) ----------
# daftar gratis di https://developer.jamendo.com -> buat app -> Client ID
JAMENDO_CLIENT_ID=

# ---------- Email: Resend (opsional) ----------
RESEND_API_KEY=
EMAIL_FROM="Ngaturi <noreply@ngaturi.com>"

# ---------- Monitoring (opsional) ----------
SENTRY_DSN=

# Admin bootstrap — email dipromosikan jadi admin oleh `npm run db:seed`
ADMIN_EMAILS=
