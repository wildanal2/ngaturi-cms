[Unit]
Description=Recover the exact Ngaturi digest after host networking is ready
Wants=network-online.target
Requires=docker.service ngaturi-ingress.service
After=network-online.target docker.service ngaturi-ingress.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ngaturi/scheduler.conf
ExecStart=/opt/ngaturi-release/scripts/start-prod-runtime.sh
TimeoutStartSec=180
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
