# Deployment configuration only. No application credentials here.
NGATURI_PACKAGE=ghcr.io/wildanal2/ngaturi-cms
NGATURI_PROJECT_NAME=ngaturi-prod
NGATURI_BIND_IP=192.168.88.4
NGATURI_PORT=3009
RUNTIME_ENV_FILE=/etc/ngaturi/ngaturi.env
DEPLOY_STATE_DIR=/var/lib/ngaturi-deploy
# Enable only during the separately approved cutover, after old owners stop.
SCHEDULER_ENABLED=false
PROBE_ATTEMPTS=30
