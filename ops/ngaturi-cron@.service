[Unit]
Description=Ngaturi protected maintenance (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ngaturi/scheduler.conf
ExecStart=/opt/ngaturi-release/scripts/run-prod-cron.sh %i
TimeoutStartSec=270
UMask=0077
StandardOutput=journal
StandardError=journal
