{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Build/local compatibility config only. Phase 0 intentionally commits no
  // staging or production resource identifiers. See docs/phase-0-production-safety.md.
  "name": "ngaturi-worker-build",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
